# Copiez ce fichier en .env AVANT le premier démarrage du conteneur :
#   cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- Base de données (lues par docker-compose.yml) ---
POSTGRES_USER=libraire_user
POSTGRES_PASSWORD=libraire_password
POSTGRES_DB=librairie_db
# Port publié sur votre machine. 5432 est le port par défaut de PostgreSQL :
# s'il est déjà occupé (PostgreSQL installé sur votre poste), choisissez 5433
# et reportez la même valeur dans DB_PORT.
POSTGRES_PORT=5432

# --- Connexion de l'application Node.js (lues par server.js) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=libraire_user
DB_PASSWORD=libraire_password
DB_NAME=librairie_db

# --- Application ---
PORT=3000
